			"name": "Test Disponibilité Produit",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Statut HTTP 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Réponse en JSON\", function () {\r",
							"    pm.response.to.be.withBody;\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"pm.test(\"Produit trouvé ou non\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"isSuccess\");\r",
							"    if (jsonData.isSuccess) {\r",
							"        pm.expect(jsonData).to.have.property(\"data\");\r",
							"        console.log(\"Quantité disponible :\", jsonData.data.quantity);\r",
							"        pm.test(\"La quantité est supérieure ou égale à 0\", function () {\r",
							"            pm.expect(jsonData.data.quantity).to.be.at.least(0);\r",
							"        });\r",
							"    } else {\r",
							"        console.warn(\"Produit non trouvé ou erreur : \", jsonData.message);\r",
							"    }\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
